{
  "id": "invoicePipeline1",
  "name": "Invoice pipeline (inbox folder)",
  "active": false,
  "nodes": [
    {
      "id": "6f1c2a10-0001-4c00-8000-000000000001",
      "name": "Every 30 seconds",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300],
      "parameters": {
        "rule": {
          "interval": [
            { "field": "seconds", "secondsInterval": 30 }
          ]
        }
      }
    },
    {
      "id": "6f1c2a10-0002-4c00-8000-000000000002",
      "name": "Read inbox files",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [220, 300],
      "notes": "Every PDF/PNG still in data/inbox/ (mounted read-only at /data/inbox). Processed files are moved out by the API, so anything here is new. An empty inbox outputs nothing and the run stops.",
      "parameters": {
        "operation": "read",
        "fileSelector": "/data/inbox/*.{pdf,png,PDF,PNG}",
        "options": {}
      }
    },
    {
      "id": "6f1c2a10-0003-4c00-8000-000000000003",
      "name": "Process invoice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300],
      "onError": "continueErrorOutput",
      "notes": "POST /process: extract (cached), validate against all invoices in Postgres, upsert. Token from the 'Invoice pipeline API' Header Auth credential.",
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8765/process",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            { "parameterType": "formBinaryData", "name": "file", "inputDataFieldName": "data" }
          ]
        },
        "options": { "timeout": 300000 }
      },
      "credentials": {
        "httpHeaderAuth": { "id": "InvPipelineApi01", "name": "Invoice pipeline API" }
      }
    },
    {
      "id": "6f1c2a10-0004-4c00-8000-000000000004",
      "name": "Auto-approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [680, 200],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "6f1c2a10-0004-4c00-8000-0000000000a1",
              "leftValue": "={{ $json.status }}",
              "rightValue": "auto_approved",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "6f1c2a10-0005-4c00-8000-000000000005",
      "name": "Move to processed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 100],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8765/move",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": { "id": "InvPipelineApi01", "name": "Invoice pipeline API" }
      }
    },
    {
      "id": "6f1c2a10-0006-4c00-8000-000000000006",
      "name": "Move to needs_review + log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 300],
      "notes": "POST /move with the /process result: moves the file to data/needs_review/ and appends a row with the reasons to data/needs_review/review_log.csv.",
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8765/move",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": { "id": "InvPipelineApi01", "name": "Invoice pipeline API" }
      }
    },
    {
      "id": "6f1c2a10-0007-4c00-8000-000000000007",
      "name": "Processing failed: to needs_review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 480],
      "notes": "/process returned an error (e.g. extraction failed, quota, or a file that is not cached in cache-only mode). The file goes to needs_review with the error as the reason, so it is not retried every poll. If the API is down this call fails too and the file stays in the inbox.",
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8765/move",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ filename: $('Read inbox files').item.binary.data.fileName, status: 'error', failed_reasons: [{ rule: 'processing', issue: 'Processing failed', detail: String($json.error?.message ?? $json.error ?? 'unknown error').slice(0, 500) }] }) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": { "id": "InvPipelineApi01", "name": "Invoice pipeline API" }
      }
    }
  ],
  "connections": {
    "Every 30 seconds": {
      "main": [[{ "node": "Read inbox files", "type": "main", "index": 0 }]]
    },
    "Read inbox files": {
      "main": [[{ "node": "Process invoice", "type": "main", "index": 0 }]]
    },
    "Process invoice": {
      "main": [
        [{ "node": "Auto-approved?", "type": "main", "index": 0 }],
        [{ "node": "Processing failed: to needs_review", "type": "main", "index": 0 }]
      ]
    },
    "Auto-approved?": {
      "main": [
        [{ "node": "Move to processed", "type": "main", "index": 0 }],
        [{ "node": "Move to needs_review + log", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "tags": []
}
