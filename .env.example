# Copy to .env and fill in local values. Never commit .env.
POSTGRES_USER=invoice_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=invoices
POSTGRES_PORT=5434

# LLM extraction
# Provider: gemini | claude (stub) | openai (stub)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
# LLM_API_KEY is also accepted as a fallback name
GEMINI_API_KEY=your_api_key_here
# Seconds between requests (free tier: start slow)
LLM_REQUEST_DELAY_S=10
# Optional; unset = provider default (recommended for Gemini 3-series models)
# LLM_TEMPERATURE=

# Metabase (the dashboard script reuses the olist-analytics Metabase on :3000)
MB_API_KEY=your_metabase_admin_api_key
MB_URL=http://localhost:3000
# Read-only Postgres role Metabase connects as (scripts/create_metabase_ro.sh)
METABASE_RO_PASSWORD=change_me_too

# Pipeline API (src/api.py) used by the n8n workflow. Generate a token with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PIPELINE_API_TOKEN=change_me_long_random_token
# 1 = refuse files that are not already cached (no LLM calls); 0 = extract new files
PIPELINE_CACHE_ONLY=0
# PIPELINE_API_HOST=127.0.0.1
# PIPELINE_API_PORT=8765
